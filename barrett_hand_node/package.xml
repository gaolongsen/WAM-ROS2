<?xml version="1.0"?>
<package format="3">
  <name>barrett_hand_node</name>
  <version>0.0.0</version>
  <description>ROS 2 node for standalone BarrettHand control through libbarrett.</description>
  <maintainer email="support@barrett.com">Barrett Technology Inc.</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>wam_msgs</depend>
  <depend>wam_srvs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
